#. Plugin Name of the plugin
#: simple-export-md.php
msgid "Simple Export to Markdown"
msgstr "Simple Export to Markdown"

#. Plugin URI of the plugin
#: simple-export-md.php
msgid "https://github.com/sherer-pro/simple-export-md"
msgstr "https://github.com/sherer-pro/simple-export-md"

#. Description of the plugin
#: simple-export-md.php
msgid "Adds a Gutenberg panel “Export to Markdown” with buttons to download .md or copy Markdown to clipboard."
msgstr "Додає панель Gutenberg «Експорт у Markdown» з кнопками для завантаження .md або копіювання Markdown до буфера обміну."

#. Author of the plugin
#: simple-export-md.php
msgid "Pavel Sherer"
msgstr "Pavel Sherer"

#. Author URI of the plugin
#: simple-export-md.php
msgid "https://sherer.pro"
msgstr "https://sherer.pro"

#. translators: %s: plugin name.
#: simple-export-md.php:62
#, php-format
msgid "%s cannot run."
msgstr "%s не може запуститися."

#. translators: 1: required PHP version, 2: required WordPress version.
#: simple-export-md.php:67
#, php-format
msgid "Minimum requirements: PHP %1$s and WordPress %2$s."
msgstr "Мінімальні вимоги: PHP %1$s і WordPress %2$s."

#. translators: 1: current PHP version, 2: current WordPress version.
#: simple-export-md.php:73
#, php-format
msgid "Your system: PHP %1$s, WordPress %2$s."
msgstr "Ваша система: PHP %1$s, WordPress %2$s."

#: assets/export-md.js:537
msgid "Markdown exporter is not ready. Please reload the editor."
msgstr "Експорт Markdown не готовий. Перезавантажте редактор."

#: assets/export-md.js:543
msgid "Clipboard is not available in this browser."
msgstr "Буфер обміну недоступний у цьому браузері."

#: assets/export-md.js:659
#: assets/export-md.js:715
msgid "Could not load all categories and tags. Please retry."
msgstr "Не вдалося завантажити всі категорії та мітки. Спробуйте ще раз."

#: assets/export-md.js:675
msgid "Markdown copied to clipboard."
msgstr "Markdown скопійовано до буфера обміну."

#: assets/export-md.js:677
msgid "Failed to copy Markdown."
msgstr "Не вдалося скопіювати Markdown."

#: assets/export-md.js:693
msgid "Markdown file generated and downloaded."
msgstr "Файл .md згенеровано й завантажено."

#: assets/export-md.js:695
msgid "Failed to download Markdown."
msgstr "Не вдалося завантажити файл Markdown."

#: assets/export-md.js:703
msgid "Loading terms..."
msgstr "Завантаження термінів..."

#: assets/export-md.js:704
msgid "Processing..."
msgstr "Обробка…"

#: assets/export-md.js:710
msgid "Export to Markdown"
msgstr "Експорт у Markdown"

#: assets/export-md.js:719
msgid "Retry loading terms"
msgstr "Повторити завантаження"

#: assets/export-md.js:750
msgid "Download .md"
msgstr "Завантажити .md"

#: assets/export-md.js:751
msgid "Copy Markdown"
msgstr "Копіювати Markdown"

#: assets/export-md.js:737
msgid "Markdown will omit content from these blocks:"
msgstr "Під час експорту буде пропущено вміст цих блоків:"

#: assets/export-md.js:83
#: assets/export-md.js:89
msgid "An export extension timed out. Please retry."
msgstr "Перевищено час очікування розширення експорту. Спробуйте ще раз."

#: assets/export-md.js:90
msgid "An export extension failed. Please retry or use standard export."
msgstr "Помилка розширення експорту. Спробуйте ще раз або виберіть стандартний експорт."

#: assets/export-md.js:96
msgid "SVG export requires static SVG without scripts, CSS, foreignObject or external resources."
msgstr "Для експорту потрібен статичний SVG без скриптів, CSS, foreignObject і зовнішніх ресурсів."

#: assets/export-md.js:160
#: assets/export-md.js:249
