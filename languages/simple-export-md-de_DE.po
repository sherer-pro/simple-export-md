msgstr "Begriffe werden geladen..."

#: assets/export-md.js:354
msgid "Processing..."
msgstr "Verarbeitung…"

#: assets/export-md.js:360
msgid "Export to Markdown"
msgstr "Als Markdown exportieren"

#: assets/export-md.js:369
msgid "Retry loading terms"
msgstr "Erneut laden"

#: assets/export-md.js:388
