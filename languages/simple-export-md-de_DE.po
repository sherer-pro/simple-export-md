#. Plugin Name of the plugin
#: simple-export-md.php
msgid "Simple Export to Markdown"
msgstr "Simple Export to Markdown"

#. Plugin URI of the plugin
#: simple-export-md.php
msgid "https://github.com/sherer-pro/simple-export-md"
msgstr "https://github.com/sherer-pro/simple-export-md"

#. Description of the plugin
#: simple-export-md.php
msgid "Adds a Gutenberg panel “Export to Markdown” with buttons to download .md or copy Markdown to clipboard."
msgstr "Fügt ein Gutenberg-Panel „Als Markdown exportieren“ mit Schaltflächen zum Herunterladen von .md-Dateien oder zum Kopieren von Markdown in die Zwischenablage hinzu."

#. Author of the plugin
#: simple-export-md.php
msgid "Pavel Sherer"
msgstr "Pavel Sherer"

#. Author URI of the plugin
#: simple-export-md.php
msgid "https://sherer.pro"
msgstr "https://sherer.pro"

#. translators: %s: plugin name.
#: simple-export-md.php:62
#, php-format
msgid "%s cannot run."
msgstr "%s kann nicht ausgeführt werden."

#. translators: 1: required PHP version, 2: required WordPress version.
#: simple-export-md.php:67
#, php-format
msgid "Minimum requirements: PHP %1$s and WordPress %2$s."
msgstr "Mindestanforderungen: PHP %1$s und WordPress %2$s."

#. translators: 1: current PHP version, 2: current WordPress version.
#: simple-export-md.php:73
#, php-format
msgid "Your system: PHP %1$s, WordPress %2$s."
msgstr "Ihr System: PHP %1$s, WordPress %2$s."

#: assets/export-md.js:243
msgid "Markdown exporter is not ready. Please reload the editor."
msgstr "Der Markdown-Export ist nicht bereit. Bitte laden Sie den Editor neu."

#: assets/export-md.js:249
msgid "Clipboard is not available in this browser."
msgstr "Die Zwischenablage ist in diesem Browser nicht verfügbar."

#: assets/export-md.js:317
#: assets/export-md.js:365
msgid "Could not load all categories and tags. Please retry."
msgstr "Nicht alle Kategorien und Schlagwörter konnten geladen werden. Bitte versuchen Sie es erneut."

#: assets/export-md.js:330
msgid "Markdown copied to clipboard."
msgstr "Markdown in die Zwischenablage kopiert."

#: assets/export-md.js:332
msgid "Failed to copy Markdown."
msgstr "Markdown konnte nicht kopiert werden."

#: assets/export-md.js:344
msgid "Markdown file generated and downloaded."
msgstr "Markdown-Datei erstellt und heruntergeladen."

#: assets/export-md.js:346
