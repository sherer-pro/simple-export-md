#. Plugin Name of the plugin
#: simple-export-md.php
msgid "Simple Export to Markdown"
msgstr "Simple Export to Markdown"

#. Plugin URI of the plugin
#: simple-export-md.php
msgid "https://github.com/sherer-pro/simple-export-md"
msgstr "https://github.com/sherer-pro/simple-export-md"

#. Description of the plugin
#: simple-export-md.php
msgid "Adds a Gutenberg panel “Export to Markdown” with buttons to download .md or copy Markdown to clipboard."
msgstr "Aggiunge un pannello Gutenberg «Esporta in Markdown» con pulsanti per scaricare .md o copiare Markdown negli appunti."

#. Author of the plugin
#: simple-export-md.php
msgid "Pavel Sherer"
msgstr "Pavel Sherer"

#. Author URI of the plugin
#: simple-export-md.php
msgid "https://sherer.pro"
msgstr "https://sherer.pro"

#. translators: %s: plugin name.
#: simple-export-md.php:62
#, php-format
msgid "%s cannot run."
msgstr "%s non può essere eseguito."

#. translators: 1: required PHP version, 2: required WordPress version.
#: simple-export-md.php:67
#, php-format
msgid "Minimum requirements: PHP %1$s and WordPress %2$s."
msgstr "Requisiti minimi: PHP %1$s e WordPress %2$s."

#. translators: 1: current PHP version, 2: current WordPress version.
#: simple-export-md.php:73
#, php-format
msgid "Your system: PHP %1$s, WordPress %2$s."
msgstr "Il tuo sistema: PHP %1$s, WordPress %2$s."

#: assets/export-md.js:537
